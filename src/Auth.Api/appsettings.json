{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": { "Default": "Data Source=auth.db" },
  "Jwt": {
    "Issuer": "https://auth.local",
    "Audience": "auth-api",
    "AccessTokenMinutes": 10,
    "ClockSkewSeconds": 30,
    "GenerateMissingKeys": false,
    "SigningKeys": [ { "Kid": "dev-1", "Path": "keys/jwt-dev-1.pem", "Active": true } ]
  },
  "Sessions": { "SlidingDays": 30, "AbsoluteDays": 90, "RefreshGraceMinutes": 3, "ValidationCacheSeconds": 30 },
  "PasswordHashing": { "MemoryKiB": 65536, "Iterations": 3, "Parallelism": 4, "MaxConcurrentHashes": 4 },
  "PasswordPolicy": { "MinLength": 12, "MaxLength": 128 },
  "Lockout": { "MaxFailedAttempts": 5, "LockoutMinutes": 15 },
  "Hibp": { "Enabled": true, "FailOpen": true, "TimeoutSeconds": 3, "MinBreachCount": 1 },
  "Mfa": { "Issuer": "Auth", "ChallengeMinutes": 5, "RecoveryCodes": 10 },
  "Tokens": { "EmailConfirmationHours": 24, "PasswordResetMinutes": 60, "EmailCooldownSeconds": 60 },
  "Cors": { "AllowedOrigins": [ "http://localhost:5173" ] },
  "Frontend": { "BaseUrl": "http://localhost:5173" },
  "Network": { "TrustProxy": false, "KnownProxies": [], "KnownNetworks": [] },
  "RateLimiting": { "Enabled": true, "StrictPerMinute": 5, "LoginPerMinute": 10, "MfaPerMinute": 5, "RefreshPerMinute": 10, "GlobalPerMinute": 100 },
  "Features": { "BetaWhitelist": false },
  "Email": { "Provider": "Logging", "From": "noreply@example.com", "FromName": "Auth", "Smtp": { "Host": "", "Port": 587, "UseStartTls": true } },
  "DataProtection": { "KeysPath": "keys/dp" },
  "Audit": { "RetentionDays": 180 },
  "Maintenance": { "Enabled": true, "IntervalMinutes": 60, "KeepInactiveSessionsDays": 30 },
  "Seed": { "AdminEmail": "" }
}
